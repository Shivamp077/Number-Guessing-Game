import random

secret_num = random.randint(1, 100)
guess = 0
while True:
    try:
        guess_num = int(input("Enter number: "))
        guess += 1
    except ValueError:
        print("Invalid input, enter a number(1-100)")
        continue

    if guess_num == secret_num:
        print("You won")
        print("Number of guesses:", guess)
        break
    elif guess_num > secret_num:
        print("Too high")
    else:
        print("Too low")    